# ==============================================================================
# EstateAI Frontend – Environment Variables Reference
# Copy this file to .env and set your backend URL.
# ==============================================================================

# Backend API base URL
# Local development:
VITE_API_BASE_URL=http://localhost:8000

# EC2 / production deployment (set to your server IP or domain):
# VITE_API_BASE_URL=http://<your-ec2-ip>:8000
# or with nginx reverse proxy:
# VITE_API_BASE_URL=https://yourdomain.com
