# ==============================================================================
# EstateAI — Production Environment Configuration Template
# Amazon Bedrock + Amazon S3 + Amazon EC2
# ==============================================================================

# Application Environment
APP_ENV=production
APP_NAME=EstateAI

# AWS Authentication & Region (uses EC2 IAM Instance Role in production)
AWS_REGION=ap-south-1
# AWS_PROFILE is only used for local testing; omit on EC2
# AWS_PROFILE=default

# Amazon S3 Document Storage
S3_BUCKET_NAME=your-estateai-documents-bucket
S3_DOCUMENT_PREFIX=documents/

# Amazon Bedrock Configuration
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Retained AWS Analytics (Disabled for Active Deployment)
ENABLE_ATHENA=false
ENABLE_GLUE=false
ATHENA_DATABASE=real_estate_db
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-athena-results-bucket/

# Local Storage & Caching on EC2
VECTOR_STORE_PATH=./data/faiss_index
DOCUMENT_CACHE_PATH=./data/documents

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
