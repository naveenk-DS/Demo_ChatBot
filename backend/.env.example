# ==============================================================================
# EstateAI Backend – Environment Variables Reference
# Copy this file to .env and fill in real values.
# Never commit real credentials to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                     # development | production

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── AWS Region ───────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1                   # Required for Bedrock and S3

# ── AWS Credentials ──────────────────────────────────────────────────────────
# In PRODUCTION on EC2: attach an IAM instance profile; no access keys needed here.
# For LOCAL DEVELOPMENT: use AWS_PROFILE from ~/.aws/credentials:
# AWS_PROFILE=your-profile-name

# ── Amazon S3 ────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=casa-chatbot
# Unstructured documents (brochures) folder prefix:
S3_DOCUMENT_PREFIX=brochures/
# Shared structured CSV dataset folder prefix:
S3_STRUCTURED_DATA_PREFIX=Csv-data/
# Filter brochure ingestion to specific project folders (combined as brochures/<Project>/):
S3_ALLOWED_PROJECT_PREFIXES=Casamia/,Zodiac/,Highlin/,Suncity/,Aquagroue/

# ── Amazon Bedrock Nova (Conversational Generation) ──────────────────────────
BEDROCK_NOVA_MODEL_ID=amazon.nova-pro-v1:0
# Supported Nova variants: amazon.nova-pro-v1:0 | amazon.nova-lite-v1:0 | amazon.nova-micro-v1:0
BEDROCK_CHAT_MODEL_ID=amazon.nova-pro-v1:0

# ── Amazon Bedrock Knowledge Bases (Unstructured Document RAG) ───────────────
# Created and managed in AWS by Team Lead. Application connects via Retrieve API:
BEDROCK_KNOWLEDGE_BASE_ID=YOUR_BEDROCK_KNOWLEDGE_BASE_ID
# Search type according to the selected vector store capabilities: HYBRID | SEMANTIC
BEDROCK_KB_SEARCH_TYPE=HYBRID

# ── Bedrock Embeddings (Titan v2 for local dev/fallback) ─────────────────────
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# ── Local Storage (relative to backend/ directory) ──────────────────────────
VECTOR_STORE_PATH=./data/faiss_index
DOCUMENT_CACHE_PATH=./data/documents
DOCUMENT_REGISTRY_PATH=./data/document_registry.json
ENQUIRY_DB_PATH=./enquiries.db

# ── Security ─────────────────────────────────────────────────────────────────
# Required in production. Fail-closed: endpoints return 503 if missing.
ADMIN_API_KEY=your-strong-random-admin-secret-here

# ── Offline / Development Mode ───────────────────────────────────────────────
# Allow fallback to locally cached documents when S3 is not configured:
ALLOW_LOCAL_FALLBACK=true
# Disable EC2 IMDS lookup in pure local dev (no instance metadata service):
AWS_EC2_METADATA_DISABLED=true

# ── AWS Analytics (keep disabled unless actively used) ───────────────────────
ENABLE_ATHENA=false
ENABLE_GLUE=false
ATHENA_DATABASE=real_estate_db
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-athena-results-bucket/
