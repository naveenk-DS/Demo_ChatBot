APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AWS_REGION=ap-south-1
AWS_PROFILE=realestate-demo
ATHENA_DATABASE=real_estate_db
ATHENA_TABLE=properties
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://YOUR-ATHENA-RESULTS-BUCKET/
ATHENA_QUERY_TIMEOUT_SECONDS=45
MAX_RESULTS=10
COL_PROPERTY_ID=property_id
COL_LOCATION=location
COL_CITY=city
COL_BHK=bhk
COL_PRICE=price
COL_PROPERTY_TYPE=property_type
COL_IMAGE_URL=image_url
COL_STATUS=property_status
ENQUIRY_DB_PATH=./enquiries.db
